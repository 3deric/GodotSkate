code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 base_color : source_color = vec4(0.106055, 0.064922, 0.062181, 1.000000);
uniform sampler2D orm;
uniform float Roughness_Power = 1.0;
uniform sampler2D normal2 : hint_normal;
uniform float Normal_Depth = 0.10000000149012;
uniform float Rim = 0.10000000149012;
uniform float Rim_Tint = 0.5;



void fragment() {
// ColorParameter:7
	vec4 n_out7p0 = base_color;


	vec4 n_out40p0;
// Texture2D:40
	n_out40p0 = texture(orm, UV);
	float n_out40p1 = n_out40p0.r;
	float n_out40p2 = n_out40p0.g;
	float n_out40p3 = n_out40p0.b;


// FloatOp:61
	float n_in61p1 = 1.00000;
	float n_out61p0 = pow(n_out40p1, n_in61p1);


// VectorOp:49
	vec3 n_out49p0 = vec3(n_out7p0.xyz) * vec3(n_out61p0);


// Reroute:66
	vec3 n_out66p0 = n_out49p0;


// Reroute:64
	float n_out64p0 = n_out40p3;


	float n_out62p0;
// Remap:62
	float n_in62p1 = 0.00000;
	float n_in62p2 = 1.00000;
	float n_in62p3 = 0.50000;
	float n_in62p4 = 1.00000;
	{
		float __input_range = n_in62p2 - n_in62p1;
		float __output_range = n_in62p4 - n_in62p3;
		n_out62p0 = n_in62p3 + __output_range * ((n_out40p2 - n_in62p1) / __input_range);
	}


// FloatParameter:58
	float n_out58p0 = Roughness_Power;


// FloatOp:59
	float n_out59p0 = pow(n_out62p0, n_out58p0);


	vec4 n_out53p0;
// Texture2D:53
	n_out53p0 = texture(normal2, UV);


// FloatParameter:55
	float n_out55p0 = Normal_Depth;


// FloatParameter:56
	float n_out56p0 = Rim;


// FloatParameter:57
	float n_out57p0 = Rim_Tint;


// Output:0
	ALBEDO = n_out66p0;
	ALPHA = n_out64p0;
	ROUGHNESS = n_out59p0;
	NORMAL_MAP = vec3(n_out53p0.xyz);
	NORMAL_MAP_DEPTH = n_out55p0;
	RIM = n_out56p0;
	RIM_TINT = n_out57p0;


}
